[Unit]
Description=Energiedashboard (P1-meter/zon/dynamisch tarief overzicht)
After=network.target

[Service]
Type=simple
User=thuis
Group=thuis
WorkingDirectory=/opt/energiedashboard
Environment=ENERGIEDASHBOARD_DB_PAD=/media/thuis/USB-SCHIJF-1TB/energiedashboard/energie.db
Environment=ENERGIEDASHBOARD_VOORSCHOT_PAD=/media/thuis/USB-SCHIJF-1TB/energiedashboard/voorschotten.json
Environment=ENERGIEDASHBOARD_HISTORIE_PAD=/media/thuis/USB-SCHIJF-1TB/energiedashboard/historie_slimmemeter.json
# SLIMMEMETERPORTAL_API_KEY staat NIET hier (dit bestand is wereld-leesbaar)
# maar in /etc/energiedashboard/env (chmod 600) -- zie deploy/bijwerken-op-pi.sh.
EnvironmentFile=-/etc/energiedashboard/env
ExecStart=/opt/energiedashboard/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
